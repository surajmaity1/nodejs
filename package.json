    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/cookie-parser": "^1.4.10",
