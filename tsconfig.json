{
  "compilerOptions": {
    "newLine": "lf",
    "allowJs": false,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["./src"],
  "exclude": ["node_modules"]
}
